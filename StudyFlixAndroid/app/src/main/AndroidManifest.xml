<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.studyflix.android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".StudyFlixApplication"
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:roundIcon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyFlix">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StudyFlix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Firebase Cloud Messaging / Firestore offline persistence require no extra
          manifest entries beyond INTERNET; FirebaseInitProvider handles auto-init
          using google-services.json (must be placed in app/ root, not included here).
        -->
    </application>

</manifest>
